# Existing Node API remains the default and receives every API route unless explicitly routed below.
RAKSHA_API_PROXY_TARGET=http://127.0.0.1:8787

# Spring routing is opt-in and should remain false until OIDC token handoff and Phase 10 checks pass.
RAKSHA_SPRING_API_ENABLED=false
RAKSHA_SPRING_API_PROXY_TARGET=http://127.0.0.1:8081
