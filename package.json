{
  "name": "raksha-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node server/index.mjs",
    "dev:full": "node dev-full.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:api": "node server/index.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.mjs\" \"scripts/**/*.mjs\" \"*.{ts,mjs,json,yml,yaml,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"server/**/*.mjs\" \"scripts/**/*.mjs\" \"*.{ts,mjs,json,yml,yaml,md}\"",
    "sync:reference": "node scripts/refresh-public-data.mjs",
    "rag:sync": "node scripts/ingest-monitored-sources.mjs",
    "news:run": "node scripts/ingest-monitored-sources.mjs",
    "db:migrate": "node scripts/migrate-db.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "prettier": "^3.6.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
