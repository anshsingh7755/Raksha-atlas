RAKSHA_ADMIN_TOKEN=replace-with-a-long-random-secret
HOST=127.0.0.1
PORT=8787
PUBLIC_SITE_URL=http://127.0.0.1:5173
CORS_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=
DATABASE_SSL=false
DB_POOL_SIZE=8
DB_PASSWORD=replace-with-a-long-random-database-password
# Local-only Spring Boot JWT signing key (minimum 32 characters); never reuse in production
RAKSHA_JWT_SECRET=replace-with-a-distinct-local-only-secret-at-least-32-characters
RAKSHA_AI_SERVICE_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_SUMMARY_MODEL=gpt-6-luna
RAG_WEB_SEARCH=true
AI_ENRICH_LIMIT=10
METADATA_EXTRACT_LIMIT=12
YOUTUBE_SEARCHES_PER_RUN=1
YOUTUBE_API_KEY=
X_BEARER_TOKEN=

# Public PDF extraction worker (allowlist is intentionally empty by default)
DOCUMENT_WORKER_TOKEN=replace-with-a-long-random-worker-secret
DOCUMENT_ALLOWED_HOSTS=
DOCUMENT_EXTRACTION_URL=http://127.0.0.1:8001
DOCUMENT_MAX_FILE_BYTES=26214400
DOCUMENT_MAX_PAGES=300
DOCUMENT_MAX_TEXT_CHARS=200000
DOCUMENT_MAX_OCR_PAGES=20
